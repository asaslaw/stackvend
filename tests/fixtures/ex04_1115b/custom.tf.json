{
  "//": "Rendered by StackVend from infra/workload/iac_intent.json (intent_sha256=b224f7a3851771ee49113762ea4a30fc3c29b72c0e33263491b69dc0c2e4aad7). Do not edit: change the intent instead.",
  "module": {
    "stream_events": {
      "ack_deadline_seconds": 20,
      "enable_subscription": true,
      "message_retention_duration": "604800s",
      "project_id": "${var.project_id}",
      "source": "../modules/messaging-pubsub",
      "topic_name_suffix": "stream-events",
      "workload_sa_email": "${module.foundation.workload_sa_email}"
    }
  },
  "output": {
    "firestore_database_name": {
      "description": "Foundation Firestore database name",
      "value": "${module.foundation.database_name}"
    },
    "stream_events_topic": {
      "description": "Pub/Sub topic name for stream events",
      "value": "${module.stream_events.topic_name}"
    },
    "stream_gke_subscription": {
      "description": "Pub/Sub pull subscription name for GKE stream worker",
      "value": "${google_pubsub_subscription.stream_gke_sub.name}"
    },
    "stream_worker_sa_email": {
      "description": "Dedicated GCP service account email for stream worker",
      "value": "${google_service_account.stream_worker.email}"
    }
  },
  "resource": {
    "google_project_iam_member": {
      "stream_worker_datastore_user": {
        "member": "serviceAccount:${google_service_account.stream_worker.email}",
        "project": "${var.project_id}",
        "role": "roles/datastore.user"
      },
      "stream_worker_log_writer": {
        "member": "serviceAccount:${google_service_account.stream_worker.email}",
        "project": "${var.project_id}",
        "role": "roles/logging.logWriter"
      }
    },
    "google_pubsub_subscription": {
      "stream_gke_sub": {
        "ack_deadline_seconds": 20,
        "message_retention_duration": "604800s",
        "name": "stream-gke-sub",
        "topic": "${module.stream_events.topic_id}"
      }
    },
    "google_pubsub_subscription_iam_member": {
      "stream_worker_module_sub_subscriber": {
        "member": "serviceAccount:${google_service_account.stream_worker.email}",
        "role": "roles/pubsub.subscriber",
        "subscription": "${module.stream_events.subscription_name}"
      },
      "stream_worker_sub_subscriber": {
        "member": "serviceAccount:${google_service_account.stream_worker.email}",
        "role": "roles/pubsub.subscriber",
        "subscription": "${google_pubsub_subscription.stream_gke_sub.name}"
      },
      "workload_sa_sub_subscriber": {
        "member": "serviceAccount:${module.foundation.workload_sa_email}",
        "role": "roles/pubsub.subscriber",
        "subscription": "${google_pubsub_subscription.stream_gke_sub.name}"
      }
    },
    "google_service_account": {
      "stream_worker": {
        "account_id": "sa-stream-worker",
        "display_name": "Stream Worker Service Account"
      }
    },
    "google_service_account_iam_member": {
      "workload_sa_impersonate_stream_worker": {
        "member": "serviceAccount:${module.foundation.workload_sa_email}",
        "role": "roles/iam.serviceAccountUser",
        "service_account_id": "${google_service_account.stream_worker.name}"
      }
    }
  }
}
